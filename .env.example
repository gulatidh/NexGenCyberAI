# NexGenCyberAI — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=NexGenCyberAI
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=http://localhost:3000,https://nexgencyberai.azurewebsites.net

# ── Azure Entra ID ─────────────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-backend-app-registration-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./nexgencyberai.db
# Production: mssql+pymssql://user:pass@server.database.windows.net/nexgencyberai

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Encryption (for connector credentials at rest) ────────────────────────────
ENCRYPTION_KEY=a-random-32-char-key-for-fernet

# ── AI Providers ───────────────────────────────────────────────────────────────
# Set DEFAULT_AI_PROVIDER to one of: azure_openai | openai | anthropic | google_gemini | aws_bedrock
DEFAULT_AI_PROVIDER=azure_openai

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI (direct)
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# AWS Bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY=
AWS_BEDROCK_SECRET_KEY=

# ── Frontend (React env vars) ──────────────────────────────────────────────────
REACT_APP_AZURE_CLIENT_ID=your-frontend-app-registration-client-id
REACT_APP_AZURE_TENANT_ID=your-tenant-id
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_REDIRECT_URI=http://localhost:3000
