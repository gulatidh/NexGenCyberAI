# ── Port ─────────────────────────────────────────────────────────────────────
# Change this to run on a different port (e.g. 9000, 443)
PORT=8080

# ── Azure AD (MSAL) — required ────────────────────────────────────────────────
# Find these in Azure Portal → App Registrations → your app
REACT_APP_CLIENT_ID=your-azure-ad-app-client-id
REACT_APP_TENANT_ID=your-azure-ad-tenant-id
AZURE_TENANT_ID=your-azure-ad-tenant-id

# Admin email addresses (comma-separated) — bypass trial limits
INITIAL_ADMIN_EMAILS=admin@yourdomain.com

# ── AI Providers — configure at least one ────────────────────────────────────

# Azure OpenAI (recommended)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
